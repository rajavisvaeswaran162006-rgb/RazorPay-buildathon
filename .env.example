# TechMart AI Shopping Agent - Environment Variables Template
# Copy this file to .env and configure your keys:

# OpenAI API Configuration (Optional: system includes 100% deterministic fallback)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Google Gemini API Key (Optional: for real-time web comparison with Google Search grounding)
GEMINI_API_KEY=your_gemini_api_key_here

# Razorpay Test Mode Credentials (Optional: simulated gateway active by default)
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
